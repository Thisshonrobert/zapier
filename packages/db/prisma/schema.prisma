
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  isSupportOperator Boolean @default(false)
  // Null for accounts that sign in through Clerk (Google) — they never set one.
  password String?
  zap      Zap[]
}

model TriageAccessAudit {
  id             String   @id @default(uuid())
  actorId        Int
  subjectOwnerId Int?
  caseId         String?
  action         String
  outcome        String
  createdAt      DateTime @default(now())
  replayRequest  ReplayRequest?

  @@index([actorId, createdAt])
  @@index([caseId, createdAt])
}

model TriageProposal {
  id                 String   @id @default(uuid())
  investigationId    String
  caseId             String
  subjectOwnerId     Int
  version            Int
  disposition        String
  status             String
  proposal           Json
  policy             Json
  evidenceHash       String
  configurationHash  String?
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  approval           TriageApproval?

  @@unique([investigationId, version])
  @@index([caseId, subjectOwnerId])
}

model TriageApproval {
  id              String   @id
  proposalId      String   @unique
  proposal        TriageProposal @relation(fields: [proposalId], references: [id])
  caseId          String
  subjectOwnerId  Int
  approvedBy      Int
  decision        String
  proposalVersion Int
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  notification    TriageDecisionNotification?
  replayRequest   ReplayRequest?

  @@index([caseId, subjectOwnerId])
}

// Immutable authority: the unique approval reference is its one-time consumption.
// Execution state belongs to ReplayExecution; original Phase 3 rows are never reset.
model ReplayRequest {
  id                 String @id
  approvalId         String @unique
  approval           TriageApproval @relation(fields: [approvalId], references: [id])
  proposalVersion    Int
  caseId             String @unique
  originalFailure    ZapRunRetry @relation(fields: [caseId], references: [id])
  subjectOwnerId     Int
  approvedBy         Int
  requestedBy        Int
  zapRunId           String
  run                ZapRun @relation(fields: [zapRunId], references: [id])
  stage              Int
  originalExecutionId String
  originalExecutionRow ZapRunExecution @relation(fields: [originalExecutionId], references: [id])
  generation         Int
  actionFingerprint  String
  requestFingerprint String
  handlerVersion     String
  evidenceHash       String
  notBefore          DateTime
  expiresAt          DateTime
  auditId            String @unique
  audit              TriageAccessAudit @relation(fields: [auditId], references: [id])
  originalExecution  Json
  createdAt          DateTime @default(now())
  execution          ReplayExecution?

  @@unique([originalExecutionId, generation])
  @@index([zapRunId, stage])
}

// A replay has its own one-attempt/failure history, preserving existing uniqueness.
model ReplayExecution {
  requestId    String @id
  request      ReplayRequest @relation(fields: [requestId], references: [id])
  status       String @default("RESERVED")
  claimToken   String?
  leaseUntil   DateTime?
  completedAt  DateTime?
  attempts     ReplayExecutionAttempt[]
  failure      ReplayFailure?
}

model ReplayExecutionAttempt {
  id                 String @id @default(uuid())
  requestId          String
  execution          ReplayExecution @relation(fields: [requestId], references: [requestId])
  attemptNumber      Int
  status             String
  provider           String?
  phase              String?
  safeCode           String?
  providerStatus     Int?
  retryAfterSeconds  Int?
  safeReceiptId      String?
  actionFingerprint  String
  requestFingerprint String
  startedAt          DateTime @default(now())
  completedAt        DateTime?

  @@unique([requestId, attemptNumber])
}

model ReplayFailure {
  id                 String @id @default(uuid())
  requestId          String @unique
  execution          ReplayExecution @relation(fields: [requestId], references: [requestId])
  providerOutcome    String
  provider           String?
  phase              String?
  safeCode           String?
  providerStatus     Int?
  retryAfterSeconds  Int?
  safeReceiptId      String?
  actionFingerprint  String
  requestFingerprint String
  createdAt          DateTime @default(now())
}

model TriageDecisionNotification {
  decisionId      String @id
  approval        TriageApproval @relation(fields: [decisionId], references: [id])
  investigationId String
  caseId          String
  subjectOwnerId  Int
  decision        String
  createdAt       DateTime @default(now())
  deliveredAt     DateTime?
  nextAttemptAt   DateTime @default(now())

  @@index([deliveredAt, nextAttemptAt])
}

model Zap {
  id      String   @id @default(uuid())
  name    String?  @default("Untitled Zap")
  time    DateTime @default(now())
  trigger Trigger? // for 1-1 no need for @relation
  actions Action[]
  userId  Int
  user    User     @relation(fields: [userId], references: [id])
  zapRun  ZapRun[]
}

model Trigger {
  id     String               @id @default(uuid())
  zapId  String               @unique
  typeId String
  zap    Zap                  @relation(fields: [zapId], references: [id])
  type   AvailableTriggerType @relation(fields: [typeId], references: [id])
}

model Action {
  id           String          @id @default(uuid())
  actionId     String
  type         AvailableAction @relation(fields: [actionId], references: [id])
  metadata     Json            @default("{}")
  zapId        String        
  zap          Zap             @relation(fields: [zapId], references: [id])
  sortingOrder Int             @default(0)
   @@index([zapId])
}

model AvailableAction {
  id       String   @id @default(uuid())
  name     String
  imageUrl String
  action   Action[]
}

model AvailableTriggerType {
  id       String    @id @default(uuid())
  name     String
  imageUrl String
  trigger  Trigger[]
}

//when was the Zap triggered

model ZapRun {
  id           String        @id @default(uuid())
  metadata     Json
  zapId        String       
  zap          Zap           @relation(fields: [zapId], references: [id])
  zapRunOutbox ZapRunOutbox?
  replayRequests ReplayRequest[]
}

model ZapRunOutbox {
  id       String @id @default(uuid())
  zapRunId String @unique
  zapRun   ZapRun @relation(fields: [zapRunId], references: [id])
}

model TestTriggerBuffer {
  id        String   @id @default(uuid())
  userId    Int
  tempZapId String
  payload   Json
  createdAt DateTime @default(now())
}

// Durable terminal failure record. Its UUID is the canonical failureId used by
// the later DLQ publisher; worker execution never publishes directly.
model ZapRunRetry {
  id                 String           @id @default(uuid())
  zapRunId           String
  stage              Int
  attempt            Int              @default(0)
  lastError          String?
  nextRunAt          DateTime         @default(now())
  createdAt          DateTime         @default(now())
  executionId        String?          @unique
  execution          ZapRunExecution? @relation(fields: [executionId], references: [id])
  provider           String?
  phase              String?
  providerOutcome    String?
  safeCode           String?
  providerStatus     Int?
  retryAfterSeconds  Int?
  safeReceiptId      String?
  actionFingerprint  String?
  requestFingerprint String?
  requiresHuman      Boolean          @default(true)
  dlqPublishedAt     DateTime?
  evidenceSource     String?
  dlqPublishClaimToken String?
  dlqPublishLeaseUntil DateTime?
  dlqNextAttemptAt   DateTime?
  dlqPublishAttempts Int              @default(0)
  replayRequest      ReplayRequest?

  @@index([zapRunId])
  @@index([dlqPublishedAt, dlqNextAttemptAt])
}

// Durable action-stage execution fenced by a per-claim token.
model ZapRunExecution {
  id                 String                   @id @default(uuid())
  zapRunId           String
  stage              Int
  status             String                   @default("PENDING")
  leaseUntil         DateTime?
  createdAt          DateTime                 @default(now())
  completedAt        DateTime?
  claimToken         String?
  providerOutcome    String?
  handlerVersion     String?
  actionFingerprint  String?
  requestFingerprint String?
  requiresHuman      Boolean                  @default(false)
  attempts           ZapRunExecutionAttempt[]
  failure            ZapRunRetry?
  replayRequests     ReplayRequest[]

  @@unique([zapRunId, stage])
  @@index([zapRunId])
}

model ZapRunExecutionAttempt {
  id                 String          @id @default(uuid())
  executionId        String
  execution          ZapRunExecution @relation(fields: [executionId], references: [id])
  attemptNumber      Int
  status             String
  provider           String?
  phase              String?
  safeCode           String?
  providerStatus     Int?
  retryAfterSeconds  Int?
  safeReceiptId      String?
  actionFingerprint  String
  requestFingerprint String
  startedAt          DateTime        @default(now())
  completedAt        DateTime?

  @@unique([executionId, attemptNumber])
  @@index([executionId])
}

/**ZapRun
  │
  └── stage 1
       │
       ▼
  ZapRunExecution(What is the state of this particular stage?)
       │
       ├── Attempt #1
       ├── Attempt #2
       └── Attempt #3
              │
              ▼
        ZapRunExecutionAttempt(What happened during each individual attempt? ,IF I PUT EVERYTHING IN ZapRunExecution, then the history will be lost)

If all attempts ultimately fail:
              │
              ▼
        ZapRunRetry(What is the durable terminal failure that needs recovery/DLQ handling?)
        **/
