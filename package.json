{
  "name": "zapier",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test:replay-recovery": "prisma generate --schema packages/db/prisma/schema.prisma && node --experimental-transform-types --import ./apps/primary_backend/tests/node-typescript-register.mjs --test apps/primary_backend/tests/replay-recovery.integration.test.ts",
    "postinstall": "node patches/kafkajs-bun-fix.js"

    
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "turbo": "^2.6.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.2.20",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@prisma/extension-accelerate": "^2.0.2"
  }
}
